{
  "name": "profile-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-hugo-data.mjs com && hugo server --disableFastRender",
    "build": "node scripts/prepare-hugo-data.mjs com && hugo --minify --gc --destination dist",
    "build:cn": "node scripts/prepare-hugo-data.mjs cn && hugo --minify --gc --baseURL https://debuginn.cn/ --destination dist",
    "dev:next": "next dev",
    "build:next": "next build",
    "lint": "eslint",
    "gen:lqip": "node scripts/gen-lqip.mjs",
    "gen:blog": "node scripts/gen-blog.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "d3-geo": "^3.1.1",
    "next": "16.2.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "sharp": "^0.34.0",
    "typescript": "^5"
  }
}
